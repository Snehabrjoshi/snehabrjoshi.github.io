# Copy to .env and fill in. .env is git-ignored.
# Web3Forms access key for the Contact page's note card (free at web3forms.com;
# the key is public by design: it only lets the form send to your inbox).
VITE_WEB3FORMS_KEY=

# Base URL of the API worker (worker/, Cloudflare Workers), no trailing slash,
# e.g. https://portfolio-api.<your-subdomain>.workers.dev
# Printed by `npx wrangler deploy` (worker/README.md). Empty = the Reading and
# Playlist cards show the build-time data only.
VITE_API_BASE=
